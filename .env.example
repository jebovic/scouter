# Backend
DATABASE_URL=postgres://scouter:scouter@postgres:5432/scouter?sslmode=disable
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=ollama           # anthropic | ollama | routing (default: ollama)
PORT=8080
ENV=development               # development | production

# Phase 9 — Ollama Smart Routing
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HEAVY_MODEL=qwen3:14b          # primary tool-use model (default: qwen3:14b)
OLLAMA_FAST_MODEL=qwen3:4b            # lighter fallback (default: qwen3:4b)
OLLAMA_HEAVY_TIMEOUT=180              # seconds (default: 180)
OLLAMA_FAST_TIMEOUT=60                # seconds (default: 60)

# Optional: cloud Ollama endpoint (e.g. ollama.com hosted models)
# OLLAMA_CLOUD_URL=https://ollama.com
# OLLAMA_CLOUD_MODEL=deepseek-v3.2:cloud
# OLLAMA_CLOUD_API_KEY=...
# OLLAMA_CLOUD_RPM=10                 # requests per minute (default: 10)

# Phase 11 — Embeddings (pgvector)
# OLLAMA_EMBED_MODEL=mxbai-embed-large

# Legacy alias (still works — maps to OLLAMA_HEAVY_MODEL)
# OLLAMA_MODEL=qwen2.5:7b

# Price-check scheduler (optional)
# PRICE_CHECK_ENABLED=true
# PRICE_CHECK_CRON=0 */6 * * *
# PRICE_CHECK_MAX_MISSIONS=10

# Frontend (Vite dev server only — Docker uses relative URLs via Traefik routing)
# VITE_API_BASE_URL=http://localhost:8080

# Aviation Stack API
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com

# Compare Flights API
COMPAREFLIGHTS_BASE_URL=https://compare-flight-prices.p.rapidapi.com
COMPAREFLIGHTS_API_KEY=

# Phase 14 — Metrics & Monitoring
METRICS_ENABLED=true
GF_SECURITY_ADMIN_PASSWORD=scouter

# MinIO — object storage for product images
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://minio.dev.local
MINIO_ACCESS_KEY=scouter
MINIO_SECRET_KEY=scouter-secret
MINIO_BUCKET=scouter-images
MINIO_QUOTA_MB=2048
